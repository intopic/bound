{
  "name": "orientim",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:fuzz": "vitest run packages/verifier/test/property.test.ts packages/verifier/test/extensions.test.ts --mode fuzz",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "integration": "node tests/integration/mainnet.ts",
    "thresholds": "node tests/integration/thresholds.ts",
    "cpi": "cargo build-sbf --manifest-path tests/cpi/attacker/Cargo.toml && node tests/cpi/run.ts",
    "dev": "npm run dev -w @orientim/web",
    "build": "npm run build -w @orientim/web",
    "build:digest": "node tools/build-digest.ts --write",
    "e2e": "node tests/e2e/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "fast-check": "^4.10.1",
    "litesvm": "^1.4.1",
    "playwright-core": "^1.63.0",
    "rolldown": "1.2.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@solana-program/compute-budget": "^0.18.1",
    "@solana-program/system": "^0.14.1",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.3.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
