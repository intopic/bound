# Copy to .env.local and fill in.

# --- Fixed at build time (compiled into the page; changing them needs a new build) -------------
# Wallet that receives the Bound fee. Leave empty for test mode (no fee).
# Pre-create its token accounts for the tokens you charge in: a swap whose input token has no
# treasury account is fee-free, because Bound never makes the user pay that rent (audit B-09).
NEXT_PUBLIC_BOUND_TREASURY=
# Fee in basis points (30 = 0.3%). The verifier refuses anything above 100 (1%).
NEXT_PUBLIC_BOUND_FEE_BPS=20
# v1 transactions for wallets that advertise them. Off until one Bound v1 swap has landed on
# mainnet; until then every wallet gets v0.
NEXT_PUBLIC_BOUND_ENABLE_V1=

# --- Server only (never sent to the browser) ------------------------------------------------------
# Solana RPC (a paid provider is recommended; the public one is rate limited).
# Helius is the provider we run on; the public endpoint only suits local work.
RPC_URL=https://api.mainnet-beta.solana.com

# Optional Jupiter API key (https://developers.jup.ag/portal). Works without it at lower limits.
JUPITER_API_KEY=

# Optional cap per swap, in USD. Unset means no limit, which is the intended setting: the
# protection is the same for any amount. While a cap applies, tokens without a USD price are
# blocked, so it also limits which tokens can be swapped.
BOUND_MAX_USD_PER_SWAP=

# The one header your hosting's ingress overwrites with the real client address (used for rate
# limits). Vercel: x-vercel-forwarded-for (default). Behind Cloudflare: cf-connecting-ip.
# Also set a rate-limit rule in the hosting firewall: this app's own limit is per instance.
BOUND_CLIENT_IP_HEADER=x-vercel-forwarded-for

# Kill switch: set to 1 to refuse new swaps. Enforced by the server (build and send), not only the UI.
BOUND_DISABLED=0

# DEXes that charge the taker persistent rent (D13).
BOUND_EXCLUDE_DEXES=HumidiFi

# F_max: maximum network fee per swap, in lamports (0.0005 SOL). Capped at 1,000,000 by the verifier.
# Lower means cheaper swaps that expire more often when the network is busy.
BOUND_MAX_NETWORK_FEE_LAMPORTS=500000

# --- Agent API (AGENT-API.md): off unless both are set -------------------------------------------
# 32 random bytes, base64: seals tickets and derives each one-time key. node tools/agent-key.ts --secret
BOUND_API_SECRET=
# While rotating: the previous secret, for the tickets it sealed (they expire within a minute).
BOUND_API_SECRET_PREVIOUS=
# id:sha256-of-key, comma-separated. node tools/agent-key.ts <id> prints a key and its entry.
BOUND_API_KEYS=
# Fee for API swaps in bps; the page's NEXT_PUBLIC_BOUND_FEE_BPS when empty.
BOUND_API_FEE_BPS=
# Requests per minute per API key and endpoint (default 60). Add a firewall rule too.
BOUND_API_PER_MINUTE=
