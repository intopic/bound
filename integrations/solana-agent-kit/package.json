{
  "name": "@orientim/plugin-solana-agent-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Protected swaps for Solana Agent Kit: the route can only use the amount the agent approved, checked on the agent's own RPC before its wallet signs.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.ts",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@solana/kit": "8.3.0"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.0",
    "solana-agent-kit": "^2.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@solana/web3.js": "1.99.0",
    "solana-agent-kit": "2.0.10",
    "zod": "3.25.76"
  }
}
